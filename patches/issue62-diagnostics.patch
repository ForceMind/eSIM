+          tilePadding: EdgeInsets.zero,
+          title: Text(_t('应用签名指纹', 'App signing fingerprints')),
+          children: [
+            _value(_t('包名', 'Package'), app['packageName']),
+            for (final hash in _list(app['currentSignerSha1']))
