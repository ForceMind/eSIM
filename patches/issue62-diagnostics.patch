diff --git a/lib/services/issue62_diagnostics.dart b/lib/services/issue62_diagnostics.dart
new file mode 100644
index 0000000..2ade15a
--- /dev/null
+++ b/lib/services/issue62_diagnostics.dart
@@ -0,0 +1,434 @@
+import 'dart:async';
+import 'dart:convert';
+
+import 'package:flutter/services.dart';
+import 'package:shared_preferences/shared_preferences.dart';
+
+/// Separate from LogBuffer: that buffer may contain APDUs and subscriber data.
+abstract interface class Issue62SnapshotStore {
+  Future<String?> read();
+  Future<void> write(String value);
+  Future<void> clear();
+}
+
+class PreferencesIssue62SnapshotStore implements Issue62SnapshotStore {
+  static const key = 'issue62.diagnostics.snapshots.v1';
+
+  @override
+  Future<String?> read() async =>
+      (await SharedPreferences.getInstance()).getString(key);
+
+  @override
+  Future<void> write(String value) async {
+    if (!await (await SharedPreferences.getInstance()).setString(key, value)) {
+      throw StateError('Local snapshot storage did not confirm the write');
+    }
+  }
+
+  @override
+  Future<void> clear() async {
+    if (!await (await SharedPreferences.getInstance()).remove(key)) {
+      throw StateError('Local snapshot storage did not confirm removal');
+    }
+  }
+}
+
+String redactIssue62Text(String value) {
+  var text = value;
+  text = text.replaceAll(
+    RegExp(r'LPA:\d+\$[^\s\r\n]+', caseSensitive: false),
+    '[redacted activation code]',
+  );
+  text = text.replaceAll(
+    RegExp(r'https?://[^\s<>]+', caseSensitive: false),
+    '[redacted URL]',
+  );
+  text = text.replaceAll(
+    RegExp(r'[A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,}', caseSensitive: false),
+    '[redacted email]',
+  );
+  text = text.replaceAll(
+    RegExp(
+      r'''["']?\b(?:ICCID|EID|IMSI|IMEI|MSISDN|phone(?:Number)?|activation(?:Code|Token)?|matchingId|password|token|PIN|PUK|APDU|ATR|selectResponse|commandData|responseData|command|response)\b["']?\s*[:=]\s*(?:"[^"\r\n]*"|'[^'\r\n]*'|[^,;\r\n]+)''',
+      caseSensitive: false,
+    ),
+    '[redacted identifier]',
+  );
+  // Do not retain an APDU/ATR/response accidentally embedded in an exception.
+  text = text.replaceAll(
+    RegExp(
+      r'(?:APDU|ATR|selectResponse|response)\s*[:=]\s*(?:[0-9A-F]{2}[\s:-]*){4,}',
+      caseSensitive: false,
+    ),
+    '[redacted card bytes]',
+  );
+  text = text.replaceAll(
+    RegExp(r'0x[0-9A-Fa-f]{16,}'),
+    '[redacted card bytes]',
+  );
+  text = text.replaceAll(
+    RegExp(r'(?:\b[0-9A-Fa-f]{2}[\s:-]+){7,}[0-9A-Fa-f]{2}\b'),
+    '[redacted card bytes]',
+  );
+  text = text.replaceAll(
+    RegExp(r'(?<![A-Za-z0-9])[0-9A-Fa-f]{24,}(?![A-Za-z0-9])'),
+    '[redacted long value]',
+  );
+  text = text.replaceAll(
+    RegExp(r'\+?\d[\d(). \t-]{6,}\d'),
+    '[redacted number]',
+  );
+  return text.length <= 1200 ? text : '${text.substring(0, 1200)}[truncated]';
+}
+
+String issue62ErrorText(Object error) {
+  if (error is PlatformException) {
+    return redactIssue62Text(
+      '${error.code}: ${error.message ?? 'Native diagnostic request failed'}',
+    );
+  }
+  if (error is TimeoutException) return 'Diagnostic operation timed out';
+  return redactIssue62Text(error.toString());
+}
+
+Map<String, dynamic> _map(Object? value) => value is Map
+    ? value.map((key, value) => MapEntry(key.toString(), value))
+    : <String, dynamic>{};
+
+Object? _safeValue(Object? value, String key) {
+  if (value == null || value is bool || value is num) return value;
+  if (value is List) {
+    return value.take(16).map((entry) => _safeValue(entry, key)).toList();
+  }
+  if (value is! String) return null;
+  if ((key == 'currentSignerSha1' || key == 'currentSignerSha256') &&
+      RegExp(r'^(?:[0-9a-fA-F]{40}|[0-9a-fA-F]{64})$').hasMatch(value)) {
+    return value;
+  }
+  if (key == 'aid' && RegExp(r'^[0-9a-fA-F]{10,32}$').hasMatch(value)) {
+    return value;
+  }
+  if ((key == 'generatedAtUtc' || key == 'timestampUtc') &&
+      DateTime.tryParse(value) != null) {
+    return value;
+  }
+  return redactIssue62Text(value);
+}
+
+Map<String, dynamic> _fields(Object? source, List<String> names) {
+  final input = _map(source);
+  return {
+    for (final name in names)
+      if (input.containsKey(name)) name: _safeValue(input[name], name),
+  };
+}
+
+Map<String, dynamic> _safeEvent(Object? value) {
+  final input = _map(value);
+  final event = _fields(input, const [
+    'timestampUtc',
+    'stage',
+    'outcome',
+    'reader',
+    'aid',
+    'retry',
+    'errorClass',
+    'message',
+    'code',
+    'statusWord',
+  ]);
+  final causes = input['causeChain'];
+  if (causes is List) {
+    event['causeChain'] = causes
+        .take(6)
+        .map(
+          (cause) => cause is Map
+              ? _fields(cause, const ['errorClass', 'message'])
+              : _safeValue(cause, 'message'),
+        )
+        .toList();
+  }
+  return event;
+}
+
+/// Whitelist the dedicated native schema, including during restoration.
+/// This intentionally cannot export LogBuffer, arbitrary PlatformException
+/// details, profile metadata, or newly added unknown native fields.
+Map<String, dynamic> sanitizeIssue62Snapshot(Object? raw) {
+  final input = _map(raw);
+  if (input['schemaVersion'] != 1) {
+    throw const FormatException('Unsupported diagnostic schema');
+  }
+  final service = _fields(input['service'], const [
+    'initialized',
+    'connectedLastObserved',
+    'profileSwitchInProgress',
+    'poisoned',
+    'poisonReason',
+  ]);
+  final readers = _map(input['service'])['readers'];
+  service['readers'] = readers is List
+      ? readers
+            .take(16)
+            .map(
+              (reader) => _fields(reader, const [
+                'reader',
+                'statusCached',
+                'secureElementPresentLastObserved',
+                'hasSession',
+                'openChannelCount',
+                'successfulChannelPreviouslyOpened',
+              ]),
+            )
+            .toList()
+      : <Object?>[];
+  final telephony = _fields(input['telephony'], const [
+    'status',
+    'mappingNote',
+    'errorClass',
+    'message',
+  ]);
+  final slots = _map(input['telephony'])['logicalSlots'];
+  telephony['logicalSlots'] = slots is List
+      ? slots
+            .take(16)
+            .map(
+              (slot) => _fields(slot, const [
+                'logicalSlotIndex',
+                'simState',
+                'subscriptionMappingStatus',
+                'subscriptionId',
+                'hasCarrierPrivileges',
+                'carrierPrivilegeStatus',
+                'errorClass',
+                'message',
+                'simStateErrorClass',
+              ]),
+            )
+            .toList()
+      : <Object?>[];
+  final allEvents = input['events'];
+  final events = allEvents is List
+      ? allEvents.map(_safeEvent).toList()
+      : <Map<String, dynamic>>[];
+  var exportDropped = input['exportDroppedEventCount'] is int
+      ? input['exportDroppedEventCount'] as int
+      : 0;
+  if (events.length > 512) {
+    exportDropped += events.length - 512;
+    events.removeRange(0, events.length - 512);
+  }
+  final snapshot = <String, dynamic>{
+    'schemaVersion': 1,
+    'generatedAtUtc': _safeValue(input['generatedAtUtc'], 'generatedAtUtc'),
+    'app': _fields(input['app'], const [
+      'packageName',
+      'versionName',
+      'versionCode',
+      'currentSignerSha1',
+      'currentSignerSha256',
+      'errorClass',
+      'message',
+    ]),
+    'device': _fields(input['device'], const [
+      'manufacturer',
+      'model',
+      'sdkInt',
+      'androidRelease',
+    ]),
+    'service': service,
+    'telephony': telephony,
+    'events': events,
+    'droppedEventCount': input['droppedEventCount'] is int
+        ? input['droppedEventCount']
+        : 0,
+    'exportDroppedEventCount': exportDropped,
+    'recording': _fields(input['recording'], const [
+      'mode',
+      'eventLimit',
+      'persistence',
+      'omitted',
+      'evidenceNote',
+      'storageErrorClass',
+    ]),
+  };
+  while (utf8.encode(jsonEncode(snapshot)).length >
+          Issue62Diagnostics.maxSnapshotBytes &&
+      events.isNotEmpty) {
+    final removeCount = (events.length / 2).ceil();
+    events.removeRange(0, removeCount);
+    exportDropped += removeCount;
+    snapshot['exportDroppedEventCount'] = exportDropped;
+  }
+  if (utf8.encode(jsonEncode(snapshot)).length >
+      Issue62Diagnostics.maxSnapshotBytes) {
+    throw const FormatException('Diagnostic metadata exceeds size limit');
+  }
+  return snapshot;
+}
+
+class Issue62Diagnostics {
+  Issue62Diagnostics({
+    MethodChannel channel = const MethodChannel('ee.nekoko.omapi_plugin'),
+    Issue62SnapshotStore? store,
+    this.timeout = const Duration(seconds: 10),
+  }) : _channel = channel,
+       _store = store ?? PreferencesIssue62SnapshotStore();
+
+  static const maxSnapshotBytes = 512 * 1024;
+  static const maxStoredBytes = 2 * 1024 * 1024;
+  final MethodChannel _channel;
+  final Issue62SnapshotStore _store;
+  final Duration timeout;
+  Map<String, dynamic>? beforeSwitch;
+  Map<String, dynamic>? afterSwitch;
+  Map<String, dynamic>? current;
+  String? captureError;
+  String? storageError;
+
+  Future<void> restore() async {
+    try {
+      final saved = await _store.read().timeout(timeout);
+      if (saved == null) return;
+      if (utf8.encode(saved).length > maxStoredBytes) {
+        throw const FormatException(
+          'Saved diagnostic report exceeds size limit',
+        );
+      }
+      final data = _map(jsonDecode(saved));
+      if (data['schemaVersion'] != 1) {
+        throw const FormatException('Unsupported saved report schema');
+      }
+      beforeSwitch = data['beforeSwitch'] == null
+          ? null
+          : sanitizeIssue62Snapshot(data['beforeSwitch']);
+      afterSwitch = data['afterSwitch'] == null
+          ? null
+          : sanitizeIssue62Snapshot(data['afterSwitch']);
+      current = data['current'] == null
+          ? null
+          : sanitizeIssue62Snapshot(data['current']);
+      captureError = data['captureError'] is String
+          ? redactIssue62Text(data['captureError'])
+          : null;
+      storageError = null;
+    } catch (error) {
+      storageError = issue62ErrorText(error);
+    }
+  }
+
+  Future<bool> capture({String? marker}) async {
+    if (marker != null &&
+        !const {'before_switch', 'after_switch', 'manual'}.contains(marker)) {
+      throw ArgumentError.value(
+        marker,
+        'marker',
+        'Unsupported diagnostic marker',
+      );
+    }
+    try {
+      final raw = await _channel
+          .invokeMethod<Object?>(
+            'getDiagnostics',
+            marker == null ? null : {'marker': marker},
+          )
+          .timeout(timeout);
+      final snapshot = sanitizeIssue62Snapshot(raw);
+      current = snapshot;
+      if (marker == 'before_switch') beforeSwitch = snapshot;
+      if (marker == 'after_switch') afterSwitch = snapshot;
+      captureError = null;
+    } catch (error) {
+      captureError = issue62ErrorText(error);
+      await _persist();
+      return false;
+    }
+    await _persist();
+    return true;
+  }
+
+  Future<void> _persist() async {
+    try {
+      final encoded = jsonEncode({
+        'schemaVersion': 1,
+        'beforeSwitch': beforeSwitch,
+        'afterSwitch': afterSwitch,
+        'current': current,
+        'captureError': captureError,
+      });
+      if (utf8.encode(encoded).length > maxStoredBytes) {
+        throw const FormatException(
+          'Diagnostic report exceeds local size limit',
+        );
+      }
+      await _store.write(encoded).timeout(timeout);
+      storageError = null;
+    } catch (error) {
+      storageError = issue62ErrorText(error);
+    }
+  }
+
+  Future<bool> clear() async {
+    try {
+      final cleared = await _channel
+          .invokeMethod<bool>('clearDiagnostics')
+          .timeout(timeout);
+      if (cleared != true) {
+        throw StateError('Native diagnostics did not confirm clearing');
+      }
+    } catch (error) {
+      captureError =
+          'Clearing native diagnostics was not confirmed: ${issue62ErrorText(error)}';
+      return false;
+    }
+    try {
+      await _store.clear().timeout(timeout);
+    } catch (error) {
+      storageError =
+          'Native log cleared; local snapshots remain: ${issue62ErrorText(error)}';
+      return false;
+    }
+    beforeSwitch = null;
+    afterSwitch = null;
+    current = null;
+    captureError = null;
+    storageError = null;
+    return true;
+  }
+
+  String exportReport() => const JsonEncoder.withIndent('  ').convert({
+    'reportType': '9esim_issue62_read_only_diagnostics',
+    'schemaVersion': 1,
+    'exportedAtUtc': DateTime.now().toUtc().toIso8601String(),
+    'beforeSwitch': beforeSwitch,
+    'afterSwitch': afterSwitch,
+    'current': current,
+    'captureError': captureError,
+    'storageError': storageError,
+    'interpretation': const [
+      'Carrier privileges and OMAPI access to an AID are separate checks.',
+      'not_confirmed means the Android API returned false, not a proven card-rule denial.',
+      'unavailable means the diagnostic could not be obtained, not a negative result.',
+      'No card ARA-M rules were read. Logical slots are not mapped to OMAPI reader names.',
+      'Snapshots are user-labelled before/after; enabled profile identity is not collected.',
+      'App certificates are public signer fingerprints, not card access rules.',
+    ],
+    'privacy': const {
+      'source':
+          'Dedicated structured native diagnostics; not the raw application log',
+      'excluded': [
+        'APDU payloads',
+        'ATR',
+        'SELECT response',
+        'ICCID',
+        'EID',
+        'IMSI',
+        'IMEI',
+        'phone number',
+        'activation code',
+        'profile names',
+      ],
+      'automaticUpload': false,
+    },
+  });
+}
