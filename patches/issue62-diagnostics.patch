+import '../utils/platform_adapter.dart';
+import '../widgets/styled_header_scaffold.dart';
+
+class Issue62DiagnosticsPage extends StatefulWidget {
+  const Issue62DiagnosticsPage({super.key, this.diagnostics});
+
+  final Issue62Diagnostics? diagnostics;
+
+  @override
+  State<Issue62DiagnosticsPage> createState() => _Issue62DiagnosticsPageState();
+}
+
+class _Issue62DiagnosticsPageState extends State<Issue62DiagnosticsPage> {
+  late final Issue62Diagnostics _diagnostics;
+  bool _busy = true;
+  String? _actionError;
+  String? _actionNotice;
+
+  bool get _zh => Localizations.localeOf(context).languageCode == 'zh';
+  String _t(String zh, String en) => _zh ? zh : en;
+
+  @override
+  void initState() {
+    super.initState();
+    _diagnostics = widget.diagnostics ?? Issue62Diagnostics();
+    _initialize();
+  }
+
+  Future<void> _initialize() async {
+    await _diagnostics.restore();
+    if (!mounted) return;
+    await _diagnostics.capture();
+    if (mounted) setState(() => _busy = false);
+  }
+
+  Future<void> _run(Future<void> Function() operation) async {
+    if (_busy) return;
+    setState(() {
+      _busy = true;
+      _actionError = null;
+      _actionNotice = null;
+    });
+    try {
+      await operation();
+    } catch (error) {
+      if (mounted) _actionError = issue62ErrorText(error);
+    } finally {
+      if (mounted) setState(() => _busy = false);
+    }
+  }
+
+  void _notice(String message) {
+    if (!mounted) return;
+    setState(() => _actionNotice = message);
+  }
+
+  Future<void> _capture(String marker) => _run(() async {
+    final captured = await _diagnostics.capture(marker: marker);
+    if (!mounted) return;
+    if (captured && _diagnostics.storageError == null) {
+      _notice(_t('已记录并保存快照', 'Snapshot captured and saved'));
+    }
+  });
+
+  Future<void> _copy() => _run(() async {
+    await Clipboard.setData(ClipboardData(text: _diagnostics.exportReport()));
+    _notice(_t('已复制脱敏诊断报告', 'Redacted diagnostic report copied'));
+  });
+
+  Future<void> _save() => _run(() async {
+    final stamp = DateTime.now()
+        .toUtc()
+        .toIso8601String()
+        .replaceAll(':', '-')
+        .replaceAll('.', '-');
+    final bytes = Uint8List.fromList(utf8.encode(_diagnostics.exportReport()));
+    final path = await FilePicker.platform.saveFile(
+      dialogTitle: _t('保存诊断报告', 'Save diagnostic report'),
+      fileName: '9esim-test4-diagnostics-$stamp.json',
+      type: FileType.custom,
+      allowedExtensions: const ['json'],
+      bytes: PlatformX.isMobile ? bytes : null,
+    );
+    if (path == null) return;
+    if (!PlatformX.isMobile) {
+      await io.File(path).writeAsBytes(bytes, flush: true);
+    }
+    _notice(_t('诊断文件已保存', 'Diagnostic file saved'));
+  });
+
+  Future<void> _clear() async {
+    if (_busy) return;
+    final confirmed = await showDialog<bool>(
+      context: context,
+      builder: (context) => AlertDialog(
+        title: Text(_t('清空诊断记录？', 'Clear diagnostic records?')),
+        content: Text(
+          _t(
+            '将清除本机的诊断事件和切换前／后快照。卡片与配置不受影响。',
+            'This clears local diagnostic events and before/after snapshots. It does not change the card or its profiles.',
+          ),
+        ),
+        actions: [
+          TextButton(
+            onPressed: () => Navigator.pop(context, false),
+            child: Text(_t('取消', 'Cancel')),
+          ),
+          TextButton(
+            onPressed: () => Navigator.pop(context, true),
+            child: Text(_t('清空', 'Clear')),
+          ),
+        ],
+      ),
+    );
+    if (confirmed != true || !mounted) return;
+    await _run(() async {
+      if (await _diagnostics.clear()) {
+        _notice(_t('诊断记录已清空', 'Diagnostic records cleared'));
+      }
+    });
+  }
+
+  Map<String, dynamic> _map(Object? value) => value is Map
+      ? value.map((key, value) => MapEntry(key.toString(), value))
+      : <String, dynamic>{};
+
+  List<dynamic> _list(Object? value) => value is List ? value : const [];
+
+  String _time(Map<String, dynamic>? snapshot) {
+    final value = snapshot?['generatedAtUtc'];
+    final parsed = value is String ? DateTime.tryParse(value)?.toLocal() : null;
+    if (parsed == null) return _t('未记录', 'Not recorded');
+    return '${parsed.month}/${parsed.day} '
+        '${parsed.hour.toString().padLeft(2, '0')}:'
+        '${parsed.minute.toString().padLeft(2, '0')}:'
+        '${parsed.second.toString().padLeft(2, '0')}';
+  }
+
+  Widget _card({required String title, required List<Widget> children}) => Card(
+    margin: const EdgeInsets.only(bottom: 16),
+    child: Padding(
+      padding: const EdgeInsets.all(18),
+      child: Column(
+        crossAxisAlignment: CrossAxisAlignment.start,
+        children: [
+          Text(title, style: Theme.of(context).textTheme.titleMedium),
+          const SizedBox(height: 12),
+          ...children,
+        ],
+      ),
+    ),
+  );
+
+  Widget _value(String label, Object? value) => Padding(
+    padding: const EdgeInsets.only(bottom: 8),
+    child: SelectableText('$label: ${value ?? _t('未知', 'Unknown')}'),
+  );
+
+  String _privilegeLabel(Object? status) => switch (status) {
+    'granted' => _t('系统确认有权限', 'Confirmed by Android'),
+    'not_confirmed' => _t(
+      '系统未确认（不等于 OMAPI 拒绝）',
+      'Not confirmed (not an OMAPI denial)',
+    ),
+    _ => _t('不可获取', 'Unavailable'),
+  };
+
+  Widget _snapshotSummary() => _card(
+    title: _t('切换前后对照', 'Before / after comparison'),
+    children: [
+      Text(
+        _t(
+          '1. 在能读卡的状态下记录“切换前”。\n2. 返回主界面完成切卡或复现错误。\n3. 回到这里记录“切换后”，保存诊断文件发给排查人员。',
+          '1. Capture “before” while card access works.\n2. Return to the main page and switch profiles or reproduce the error.\n3. Capture “after” here, then save the diagnostic file for review.',
+        ),
+      ),
+      const SizedBox(height: 14),
+      _value(_t('切换前', 'Before'), _time(_diagnostics.beforeSwitch)),
+      _value(_t('切换后', 'After'), _time(_diagnostics.afterSwitch)),
+      Wrap(
+        spacing: 10,
+        runSpacing: 10,
+        children: [
+          FilledButton.icon(
+            onPressed: _busy ? null : () => _capture('before_switch'),
+            icon: const Icon(Icons.bookmark_add_outlined),
+            label: Text(_t('记录切换前', 'Capture before')),
+          ),
+          FilledButton.tonalIcon(
+            onPressed: _busy ? null : () => _capture('after_switch'),
+            icon: const Icon(Icons.compare_arrows),
+            label: Text(_t('记录切换后', 'Capture after')),
+          ),
+          OutlinedButton.icon(
+            onPressed: _busy ? null : () => _capture('manual'),
+            icon: const Icon(Icons.fact_check_outlined),
