+package ee.nekoko.nlpa2
+
+import android.content.Context
+import android.content.pm.PackageManager
+import android.os.Build
+import android.telephony.SubscriptionManager
+import android.telephony.TelephonyManager
+import org.json.JSONArray
+import org.json.JSONObject
+import java.security.MessageDigest
+import java.time.Instant
+import java.util.concurrent.Executors
+import java.util.concurrent.Future
+import java.util.concurrent.TimeUnit
+import java.util.concurrent.TimeoutException
+import java.util.concurrent.atomic.AtomicBoolean
+
+/** App-private, bounded diagnostics. No secure-element object is passed to this class. */
+internal class OmapiDiagnostics(private val context: Context) {
+    private val preferences = context.getSharedPreferences("issue62_diagnostics_v1", Context.MODE_PRIVATE)
+    private val writer = Executors.newSingleThreadScheduledExecutor { task ->
+        Thread(task, "Issue62DiagnosticWriter").apply { isDaemon = true }
+    }
+    private val savePending = AtomicBoolean(false)
+    private val metadataWorker = Executors.newSingleThreadExecutor { task ->
+        Thread(task, "Issue62TelephonyMetadata").apply { isDaemon = true }
+    }
+    private var metadataQuery: Future<Map<String, Any?>>? = null
+    @Volatile private var storageErrorClass: String? = null
+    val recorder = OmapiDiagnosticsRecorder(onChanged = { scheduleSave() })
+
+    init {
+        try {
+            val text = preferences.getString("events", null)
+            if (text != null && text.length <= MAX_STORED_CHARS) {
+                val saved = JSONObject(text)
+                val rows = saved.optJSONArray("events") ?: JSONArray()
+                val decoded = (0 until rows.length().coerceAtMost(512)).mapNotNull { index ->
+                    rows.optJSONObject(index)?.let { decodeObject(it) }
+                }
+                recorder.restore(decoded, saved.optLong("droppedEventCount", 0))
+            }
+        } catch (error: Exception) { storageErrorClass = error.javaClass.name }
+    }
+
+    private fun scheduleSave() {
+        if (!savePending.compareAndSet(false, true)) return
+        try {
+            writer.schedule({
+                savePending.set(false)
+                saveNow()
+            }, 100, TimeUnit.MILLISECONDS)
+        } catch (error: Exception) {
+            savePending.set(false)
+            storageErrorClass = error.javaClass.name
+        }
+    }
+
+    private fun saveNow() {
+        try {
+            preferences.edit().putString("events", serializedSnapshot()).apply()
+            storageErrorClass = null
+        } catch (error: Exception) { storageErrorClass = error.javaClass.name }
+    }
+
+    private fun serializedSnapshot(): String {
+        val snapshot = recorder.snapshot()
+        val rows = (snapshot["events"] as List<*>).toMutableList()
+        var dropped = (snapshot["droppedEventCount"] as Number).toLong()
+        while (true) {
+            val text = JSONObject(mapOf("events" to rows, "droppedEventCount" to dropped)).toString()
+            if (text.length <= MAX_STORED_CHARS || rows.isEmpty()) return text
+            val count = (rows.size / 8).coerceAtLeast(1)
+            repeat(count) { rows.removeAt(0) }
+            dropped += count
+        }
+    }
+
+    fun close() {
+        // Serialize the final write behind any pending write, then stop this instance's worker.
+        try { writer.execute { saveNow() }; writer.shutdown() } catch (_: Exception) { }
+        metadataWorker.shutdownNow()
+    }
+
+    fun clear(): Boolean {
+        recorder.clear()
+        // Run after previous writer tasks; commit confirms old persisted events are gone before
+        // the UI reports success. This never runs on the OMAPI hardware executor.
+        return try {
+            writer.submit<Boolean> {
+                preferences.edit().putString("events", serializedSnapshot()).commit()
+            }.get(3, TimeUnit.SECONDS)
+        } catch (error: Exception) {
+            storageErrorClass = error.javaClass.name
+            false
+        }
+    }
+
+    fun snapshot(service: Map<String, Any?>): Map<String, Any?> {
+        val recorded = recorder.snapshot()
+        return linkedMapOf(
+                "schemaVersion" to 1,
+                "generatedAtUtc" to Instant.now().toString(),
+                "app" to appInfo(),
+                "device" to mapOf(
+                        "manufacturer" to OmapiDiagnosticsRecorder.redact(Build.MANUFACTURER),
+                        "model" to OmapiDiagnosticsRecorder.redact(Build.MODEL),
+                        "sdkInt" to Build.VERSION.SDK_INT,
+                        "androidRelease" to OmapiDiagnosticsRecorder.redact(Build.VERSION.RELEASE),
+                ),
+                "service" to service,
+                "telephony" to boundedTelephonyInfo(),
+                "events" to recorded["events"],
+                "droppedEventCount" to recorded["droppedEventCount"],
+                "recording" to mapOf(
+                        "mode" to "passive_existing_operations",
+                        "eventLimit" to 512,
+                        "persistence" to "app_private_best_effort",
+                        "storageErrorClass" to storageErrorClass,
+                        "omitted" to listOf("APDU payloads", "ATR", "SELECT response", "ICCID", "EID",
+                                "IMSI", "IMEI", "phone numbers", "activation codes", "profile names"),
+                        "evidenceNote" to "Carrier privileges and OMAPI AID authorization are separate; no ARA-M rules were read.",
+                ),
+        )
+    }
+
+    @Suppress("DEPRECATION")
+    private fun appInfo(): Map<String, Any?> = try {
+        val flags = if (Build.VERSION.SDK_INT >= 28) PackageManager.GET_SIGNING_CERTIFICATES
+                else PackageManager.GET_SIGNATURES
+        val info = context.packageManager.getPackageInfo(context.packageName, flags)
+        val signatures = if (Build.VERSION.SDK_INT >= 28) info.signingInfo?.apkContentsSigners
+                else info.signatures
+        val certificates = signatures.orEmpty().map { it.toByteArray() }
+        mapOf(
+                "packageName" to context.packageName,
+                "versionName" to info.versionName,
+                "versionCode" to if (Build.VERSION.SDK_INT >= 28) info.longVersionCode else info.versionCode.toLong(),
+                "currentSignerSha1" to certificates.map { digest(it, "SHA-1") }.distinct(),
+                "currentSignerSha256" to certificates.map { digest(it, "SHA-256") }.distinct(),
+        )
+    } catch (error: Exception) {
+        mapOf("packageName" to context.packageName, "errorClass" to error.javaClass.name,
+                "message" to OmapiDiagnosticsRecorder.redact(error.message.orEmpty()))
+    }
+
+    @Suppress("DEPRECATION")
+    private fun telephonyInfo(): Map<String, Any?> {
+        val note = "Logical slots are not mapped to OMAPI reader names. A false privilege result does not prove access-rule denial."
+        return try {
+            val manager = context.getSystemService(Context.TELEPHONY_SERVICE) as? TelephonyManager
+                    ?: return mapOf("status" to "unavailable", "logicalSlots" to emptyList<Any>(), "mappingNote" to note)
+            val count = manager.phoneCount.coerceIn(0, 4)
+            val slots = (0 until count).map { index ->
+                val slot = linkedMapOf<String, Any?>(
+                        "logicalSlotIndex" to index,
+                        "subscriptionMappingStatus" to "unavailable",
+                        "carrierPrivilegeStatus" to "unavailable",
+                        "hasCarrierPrivileges" to null,
+                )
+                try { slot["simState"] = manager.getSimState(index) }
+                catch (error: Exception) { slot["simStateErrorClass"] = error.javaClass.name }
+                try {
+                    val subscriptionId: Int? = when {
+                        Build.VERSION.SDK_INT >= 34 -> SubscriptionManager.getSubscriptionId(index)
+                        Build.VERSION.SDK_INT >= 29 -> context.getSystemService(SubscriptionManager::class.java)
+                                ?.getSubscriptionIds(index)?.firstOrNull()
+                        else -> null
+                    }
+                    if (subscriptionId == null) {
+                        slot["subscriptionMappingStatus"] = "unavailable"
+                    } else if (!SubscriptionManager.isValidSubscriptionId(subscriptionId)) {
+                        slot["subscriptionMappingStatus"] = "no_valid_subscription"
+                    } else {
+                        slot["subscriptionId"] = subscriptionId
+                        slot["subscriptionMappingStatus"] = "mapped"
+                        // Never use the default-subscription manager for a slot with no valid mapping.
+                        val granted = manager.createForSubscriptionId(subscriptionId).hasCarrierPrivileges()
+                        slot["hasCarrierPrivileges"] = granted
+                        slot["carrierPrivilegeStatus"] = if (granted) "granted" else "not_confirmed"
+                    }
+                } catch (error: Exception) {
+                    slot["errorClass"] = error.javaClass.name
+                    slot["message"] = OmapiDiagnosticsRecorder.redact(error.message.orEmpty())
+                }
+                slot
+            }
+            mapOf(
+                    "status" to when {
+                        count == 0 -> "unavailable"
+                        slots.any { it["carrierPrivilegeStatus"] == "unavailable" } -> "partial"
+                        else -> "available"
+                    },
+                    "logicalSlots" to slots,
+                    "mappingNote" to note,
+            )
+        } catch (error: Exception) {
+            mapOf("status" to "unavailable", "logicalSlots" to emptyList<Any>(), "mappingNote" to note,
+                    "errorClass" to error.javaClass.name,
+                    "message" to OmapiDiagnosticsRecorder.redact(error.message.orEmpty()))
+        }
+    }
+
+    /** A stalled telephony Binder must not prevent exporting the already recorded OMAPI events. */
+    private fun boundedTelephonyInfo(): Map<String, Any?> {
+        fun unavailable(message: String, errorClass: String? = null): Map<String, Any?> = mapOf(
+                "status" to "unavailable", "logicalSlots" to emptyList<Any>(),
+                "mappingNote" to "Logical slots are not mapped to OMAPI reader names.",
+                "message" to message, "errorClass" to errorClass,
+        )
+        // At most one pending system-metadata query. Never accumulate more tasks behind a stuck one.
+        if (metadataQuery?.isDone == false) return unavailable("Previous read-only telephony query is still pending")
+        return try {
+            val query = metadataWorker.submit<Map<String, Any?>> { telephonyInfo() }
+            metadataQuery = query
+            query.get(2, TimeUnit.SECONDS)
+        } catch (_: TimeoutException) {
+            unavailable("Read-only telephony query exceeded two seconds", "java.util.concurrent.TimeoutException")
+        } catch (error: InterruptedException) {
+            Thread.currentThread().interrupt()
+            unavailable("Read-only telephony query was interrupted", error.javaClass.name)
+        } catch (error: Exception) {
+            unavailable("Read-only telephony metadata is unavailable", error.javaClass.name)
+        }
+    }
+
+    private fun digest(bytes: ByteArray, algorithm: String): String =
+            MessageDigest.getInstance(algorithm).digest(bytes).joinToString("") { "%02X".format(it) }
+
+    private fun decodeObject(value: JSONObject): Map<String, Any?> = value.keys().asSequence().associateWith { key ->
+        decodeValue(value.opt(key))
+    }
+
+    private fun decodeValue(value: Any?): Any? = when (value) {
+        null, JSONObject.NULL -> null
+        is JSONObject -> decodeObject(value)
+        is JSONArray -> (0 until value.length().coerceAtMost(512)).map { decodeValue(value.opt(it)) }
+        is String, is Number, is Boolean -> value
+        else -> null
+    }
+
+    companion object { private const val MAX_STORED_CHARS = 2_000_000 }
+}
