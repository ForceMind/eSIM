@@ -0,0 +1,146 @@
+package ee.nekoko.nlpa2
+
+import java.time.Instant
+import java.util.ArrayDeque
+import java.util.Collections
+import java.util.IdentityHashMap
+
+/** Structured diagnostic data only. Never accepts APDU or profile payloads. */
+internal class OmapiDiagnosticsRecorder(
+        private val capacity: Int = 512,
+        private val clock: () -> String = { Instant.now().toString() },
+        private val onChanged: () -> Unit = {},
+) {
+    private val events = ArrayDeque<Map<String, Any?>>()
+    private var dropped = 0L
+
+    init { require(capacity in 1..512) }
+
+    fun record(
+            stage: String,
+            outcome: String,
+            reader: String? = null,
+            aid: String? = null,
+            retry: Int? = null,
+            error: Throwable? = null,
+            code: String? = null,
+            message: String? = null,
+            statusWord: String? = null,
+    ) {
+        val event = linkedMapOf<String, Any?>(
+                "timestampUtc" to clock(),
+                "stage" to safeLabel(stage),
+                "outcome" to safeLabel(outcome),
+        )
+        reader?.let { event["reader"] = safeReader(it) }
+        aid?.let { event["aid"] = safeAid(it) }
+        retry?.let { event["retry"] = it.coerceIn(0, 100) }
+        code?.let { event["code"] = safeLabel(it) }
+        message?.let { event["message"] = redact(it) }
+        statusWord?.takeIf { it.matches(Regex("[0-9a-fA-F]{4}")) }?.let {
+            event["statusWord"] = it.uppercase()
+        }
+        error?.let {
+            event["errorClass"] = safeClass(it.javaClass.name)
+            event["message"] = redact(it.message.orEmpty())
+            val causes = mutableListOf<Map<String, String>>()
+            val seen = Collections.newSetFromMap(IdentityHashMap<Throwable, Boolean>())
+            seen.add(it)
+            var cause = it.cause
+            while (cause != null && causes.size < 4 && seen.add(cause)) {
+                causes.add(mapOf("errorClass" to safeClass(cause.javaClass.name),
+                        "message" to redact(cause.message.orEmpty())))
+                cause = cause.cause
+            }
+            if (causes.isNotEmpty()) event["causeChain"] = causes
+        }
+        synchronized(this) {
+            if (events.size == capacity) { events.removeFirst(); dropped++ }
+            events.addLast(event)
+        }
+        try { onChanged() } catch (_: Exception) { /* Diagnostics cannot break card operations. */ }
+    }
+
+    @Synchronized
+    fun snapshot(): Map<String, Any?> = mapOf(
+            "events" to events.map { copyEvent(it) },
+            "droppedEventCount" to dropped,
+    )
+
+    fun clear() {
+        synchronized(this) { events.clear(); dropped = 0 }
+        try { onChanged() } catch (_: Exception) { }
+    }
+
+    /** Restore only this schema's bounded, re-sanitized fields from private storage. */
+    @Synchronized
+    fun restore(saved: List<Map<String, Any?>>, savedDropped: Long) {
+        events.clear()
+        dropped = savedDropped.coerceAtLeast(0) + (saved.size - capacity).coerceAtLeast(0)
+        for (raw in saved.takeLast(capacity)) {
+            val timestamp = (raw["timestampUtc"] as? String)
+                    ?.takeIf { it.length <= 40 && it.matches(Regex("[0-9TZ:.+\\-]+")) }
+                    ?: clock()
+            val clean = linkedMapOf<String, Any?>(
+                    "timestampUtc" to timestamp,
+                    "stage" to safeLabel(raw["stage"] as? String ?: "restored"),
+                    "outcome" to safeLabel(raw["outcome"] as? String ?: "unknown"),
+            )
+            (raw["reader"] as? String)?.let { clean["reader"] = safeReader(it) }
+            (raw["aid"] as? String)?.let { clean["aid"] = safeAid(it) }
+            (raw["retry"] as? Number)?.let { clean["retry"] = it.toInt().coerceIn(0, 100) }
+            (raw["code"] as? String)?.let { clean["code"] = safeLabel(it) }
+            (raw["statusWord"] as? String)?.takeIf { it.matches(Regex("[0-9A-Fa-f]{4}")) }
+                    ?.let { clean["statusWord"] = it.uppercase() }
+            (raw["message"] as? String)?.let { clean["message"] = redact(it) }
+            (raw["errorClass"] as? String)?.let { clean["errorClass"] = safeClass(it) }
+            (raw["causeChain"] as? List<*>)?.take(4)?.mapNotNull { cause ->
+                val item = cause as? Map<*, *> ?: return@mapNotNull null
+                mapOf("errorClass" to safeClass(item["errorClass"] as? String ?: "unknown"),
+                        "message" to redact(item["message"] as? String ?: ""))
+            }?.takeIf { it.isNotEmpty() }?.let { clean["causeChain"] = it }
+            events.addLast(clean)
+        }
+    }
+
+    private fun copyEvent(event: Map<String, Any?>): Map<String, Any?> = event.toMutableMap().also { copy ->
+        (event["causeChain"] as? List<*>)?.let { causes ->
+            copy["causeChain"] = causes.map { (it as Map<*, *>).toMap() }
+        }
+    }
+
+    companion object {
+        private val namedIdentifier = Regex("""(?i)["']?\b(?:iccid|eid|imsi|imei|msisdn|euiccId|cardId|subscriberId|profileName|serial(?:number|no)?|phone(?:[ _-]?number)?|activation(?:[ _-]?(?:code|token))?|matching(?:[ _-]?id)?|confirmation(?:[ _-]?code)?|token|pin[12]?|puk[12]?|password|passwd|smdp\+?)["']?\s*[:=]\s*(?:"[^"]*"|'[^']*'|[^\s,;]+)""")
+        private val payload = Regex("""(?i)["']?\b(?:apdu|atr|selectResponse|command(?:Data)?|response(?:Data)?)["']?\s*[:=]\s*(?:"[^"]*"|'[^']*'|\[[^\]]*\]|(?:0x)?(?:[0-9a-f]{2}[\s:,-]*){1,})""")
+        private val activation = Regex("""(?i)\bLPA:[^\s]+""")
+        private val url = Regex("""(?i)\b(?:https?|smdp)://[^\s]+""")
+        private val email = Regex("""[A-Za-z0-9._%+\-]+@[A-Za-z0-9.\-]+\.[A-Za-z]{2,}""")
+        private val hexBytes = Regex("""(?i)\b(?:[0-9a-f]{2}[\s:,\-]+){7,}[0-9a-f]{2}\b""")
+        private val longHex = Regex("""(?i)\b[0-9a-f]{16,}\b""")
+        private val digits = Regex("""(?<![A-Za-z0-9])\+?\d[\d .()\-]{7,}\d(?![A-Za-z0-9])""")
+        private val longToken = Regex("""\b[A-Za-z0-9_\-]{32,}\b""")
+        private val controls = Regex("[\\p{Cntrl}&&[^\\n\\t]]")
+
+        fun redact(value: String): String {
+            // Bound work before applying regexes. Truncation never re-exposes a removed identifier.
+            var text = value.take(8192)
+            for (pattern in listOf(activation, url, email, payload, namedIdentifier, hexBytes, longHex, digits, longToken)) {
+                text = pattern.replace(text, "[redacted]")
+            }
+            return controls.replace(text, " ").take(512)
+        }
+
+        fun safeReader(value: String): String =
+                value.takeIf { it.matches(Regex("SIM[0-9A-Za-z._-]{0,28}")) } ?: "[other_reader]"
+
+        fun safeAid(value: String): String =
+                value.uppercase().takeIf { it.length % 2 == 0 && it.matches(Regex("[0-9A-F]{10,32}")) }
+                        ?: "[invalid_aid]"
+
+        private fun safeLabel(value: String): String =
+                value.takeIf { it.matches(Regex("[A-Za-z0-9_.:-]{1,80}")) } ?: "unknown"
+
+        private fun safeClass(value: String): String =
+                value.takeIf { it.matches(Regex("[A-Za-z0-9_.$]{1,180}")) } ?: "unknown"
+    }
+}
