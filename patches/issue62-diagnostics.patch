+      if (recordingError != null)
+        '${_t('原生事件的跨重启保存未完成；当前快照仍可导出', 'Native event persistence did not complete; the current snapshot can still be exported')}: $recordingError',
+      ?_actionError,
+    ].join('\n');
+    return StyledHeaderScaffold(
+      title: _t('9eSIM 诊断', '9eSIM diagnostics'),
+      subtitle: _t('Test 4 · 切换前后对照', 'Test 4 · Before / after comparison'),
+      body: ListView(
+        padding: const EdgeInsets.all(16),
+        children: [
+          _card(
+            title: _t('只读诊断', 'Read-only diagnostics'),
+            children: [
+              Text(
+                _t(
+                  '被动记录现有读卡操作的通道结果和异常。这里的采集只读取诊断缓存与系统状态；不会自动切卡或重新打开卡片通道。',
+                  'Passively records channel outcomes and exceptions from existing card operations. Capturing reads diagnostic caches and system metadata; it does not switch profiles or reopen card channels.',
+                ),
+              ),
+            ],
+          ),
+          if (_busy)
+            const Padding(
+              padding: EdgeInsets.only(bottom: 16),
+              child: LinearProgressIndicator(),
+            ),
+          if (error.isNotEmpty)
+            _card(
+              title: _t('诊断提示', 'Diagnostic notice'),
+              children: [SelectableText(error)],
+            ),
+          _snapshotSummary(),
+          _card(
+            title: _t('导出脱敏报告', 'Export redacted report'),
+            children: [
+              Text(
+                _t(
+                  '报告包含切换前／后与最近一次快照、公开签名指纹和脱敏异常，不包含 APDU 正文、卡号、EID、IMSI、IMEI、手机号或激活码。文件由你选择保存或发送，App 不会自动上传。',
+                  'Includes before/after and latest snapshots, public signer fingerprints and redacted exceptions. APDU bodies, card identifiers, EID, IMSI, IMEI, phone numbers and activation codes are excluded. You choose where to save or send it; the app does not upload it automatically.',
+                ),
+              ),
+              const SizedBox(height: 14),
+              if (_actionNotice != null)
+                Padding(
+                  padding: const EdgeInsets.only(bottom: 14),
+                  child: Semantics(
+                    liveRegion: true,
+                    child: Text(
+                      _actionNotice!,
+                      style: TextStyle(
+                        color: Theme.of(context).colorScheme.primary,
+                      ),
+                    ),
+                  ),
+                ),
+              Wrap(
+                spacing: 10,
+                runSpacing: 10,
+                children: [
+                  FilledButton.icon(
+                    onPressed: _busy ? null : _save,
+                    icon: const Icon(Icons.save_alt),
+                    label: Text(_t('保存诊断文件', 'Save diagnostic file')),
+                  ),
+                  OutlinedButton.icon(
+                    onPressed: _busy ? null : _copy,
+                    icon: const Icon(Icons.copy),
+                    label: Text(_t('复制报告', 'Copy report')),
