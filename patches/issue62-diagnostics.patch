+  Widget _events(Map<String, dynamic>? snapshot) {
+    final events = _list(snapshot?['events']);
+    final recent = events.reversed.take(20).map(_map).toList();
+    return _card(
+      title: _t('最近的原生事件', 'Recent native events'),
+      children: [
+        Text(
+          _t(
+            '当前快照有 ${events.length} 条事件。这里显示最近 20 条，导出文件包含快照中保留的全部事件。',
+            '${events.length} events in this snapshot. Showing the latest 20; the export includes every retained event.',
+          ),
+        ),
+        if (events.isEmpty)
+          Padding(
+            padding: const EdgeInsets.only(top: 12),
+            child: Text(
+              _t(
+                '尚无事件。返回主界面尝试读取卡片，再来采集当前状态。',
+                'No events yet. Try reading the card on the main page, then capture the current state here.',
+              ),
+            ),
+          ),
+        for (final event in recent)
+          Padding(
+            padding: const EdgeInsets.only(top: 12),
+            child: DecoratedBox(
+              decoration: BoxDecoration(
+                color: Theme.of(context).colorScheme.surfaceContainerHighest,
+                borderRadius: BorderRadius.circular(12),
+              ),
+              child: Padding(
+                padding: const EdgeInsets.all(12),
+                child: SizedBox(
+                  width: double.infinity,
+                  child: SelectableText(
+                    [
+                      '${event['timestampUtc'] ?? ''}  ${event['stage'] ?? ''} → ${event['outcome'] ?? ''}',
+                      if (event['reader'] != null) 'Reader: ${event['reader']}',
+                      if (event['aid'] != null) 'AID: ${event['aid']}',
+                      if (event['retry'] != null) 'Retry: ${event['retry']}',
+                      if (event['code'] != null) 'Code: ${event['code']}',
+                      if (event['statusWord'] != null)
+                        'SW: ${event['statusWord']}',
+                      if (event['errorClass'] != null) '${event['errorClass']}',
+                      if (event['message'] != null) '${event['message']}',
+                      if (event['causeChain'] != null)
+                        'Causes: ${jsonEncode(event['causeChain'])}',
