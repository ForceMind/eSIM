diff --git a/lib/adapter/omapi/omapi_access_errors.dart b/lib/adapter/omapi/omapi_access_errors.dart
new file mode 100644
index 0000000..40d97b3
--- /dev/null
+++ b/lib/adapter/omapi/omapi_access_errors.dart
@@ -0,0 +1,34 @@
+import 'package:flutter/services.dart';
+
+import '../../utils/error_codes.dart';
+
+/// Only recognizes explicit access-denial evidence, never a generic channel
+/// failure. This does not diagnose which ARA-M rule (if any) caused the denial.
+bool isOmapiAccessDeniedError(Object error) {
+  if (error is AppException) {
+    return error.code == AppErrorCode.ERROR_OMAPI_PERMISSION_DENIED ||
+        error.code == AppErrorCode.ERROR_OMAPI_SECURITYEXCEPTION;
+  }
+  if (error is! PlatformException) return false;
+
+  switch (error.code) {
+    case 'SECURITY_EXCEPTION':
+    case 'SecurityException':
+    case 'AccessControlException':
+      return true;
+  }
+
+  // Compatibility with older native bridges that erased the exception type.
+  // Never let text override a safety-latch, busy, or unrelated error code.
+  if (error.code != 'CHANNEL_FAILED' && error.code != 'CONNECTION_FAILED') {
+    return false;
+  }
+  // New native bridges preserve the aggregate classification for mixed or
+  // ambiguous outcomes. A single candidate's denial message must not override it.
+  final details = error.details;
+  if (details is Map && details['permissionDenied'] == false) return false;
+
+  final message = error.message?.trim().toLowerCase() ?? '';
+  return message.contains('no apdu access allowed') ||
+      message.startsWith('access denied by ara-m:');
+}
