+++ b/android/app/src/main/kotlin/ee/nekoko/nlpa2/OmapiOpenFailures.kt
@@ -0,0 +1,37 @@
+package ee.nekoko.nlpa2
+
+/**
+ * Retain access denials across an AID scan without skipping later usable AIDs.
+ *
+ * A missing applet must not overwrite a previous SecurityException. Conversely,
+ * an I/O failure or a null channel is not proof of a permission problem: preserve
+ * the existing recovery path in these mixed/ambiguous cases.
+ *
+ * This class does not grant card access or change any ARA-M rules.
+ */
+internal class OmapiOpenFailures {
+    private var lastError: Exception? = null
+    private var accessDenied: SecurityException? = null
+    private var operationalError: Exception? = null
+    private var channelUnavailable = false
+
+    fun record(error: Exception?) {
+        if (error == null) {
+            // OMAPI can return null when no channel is available.
+            channelUnavailable = true
+            return
+        }
+        lastError = error
+        when (error) {
+            is SecurityException -> if (accessDenied == null) accessDenied = error
+            is java.util.NoSuchElementException -> Unit
+            else -> if (operationalError == null) operationalError = error
+        }
+    }
+
+    val permissionDenied: Boolean
+        get() = accessDenied != null && operationalError == null && !channelUnavailable
+
+    val errorForRetry: Exception?
+        get() = operationalError ?: lastError
+}
